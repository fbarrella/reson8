{
  "name": "reson8",
  "version": "2.7.0",
  "author": "Felipe B. Netto",
  "email": "f.netto01@gmail.com",
  "homepage": "https://github.com/fbarrella/reson8",
  "private": true,
  "description": "Self-hosted voice and text communication platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc --build --force",
    "dev:server": "npm run dev -w apps/server",
    "dev:client": "npm run dev -w apps/client",
    "release:all": "node scripts/release-all.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "app-builder-bin": "^5.0.0-alpha.10"
  }
}
