{
    "name": "@reson8/client",
    "version": "2.0.0",
    "description": "Reson8 — Voice and text communication client",
    "author": {
        "name": "Felipe B. Netto",
        "email": "f.netto01@gmail.com",
        "url": "https://github.com/fbarrella/reson8"
    },
    "homepage": "https://github.com/fbarrella/reson8",
    "private": true,
    "main": "dist/main.js",
    "scripts": {
        "dev": "tsc --build && node scripts/copy-html.mjs && electron .",
        "prebuild": "tsc --build && node scripts/copy-html.mjs",
        "build": "electron-builder",
        "build:win": "node scripts/build-signed.mjs --win",
        "build:linux": "node scripts/build-signed.mjs --linux",
        "build:mac": "node scripts/build-signed.mjs --mac",
        "test-build:win": "node scripts/test-build.mjs win",
        "test-build:linux": "node scripts/test-build.mjs linux",
        "test-build:mac": "node scripts/test-build.mjs mac",
        "typecheck": "tsc --noEmit"
    },
    "build": {
        "appId": "com.reson8.client",
        "productName": "Reson8",
        "electronVersion": "34.5.8",
        "npmRebuild": false,
        "directories": {
            "output": "release"
        },
        "publish": {
            "provider": "github",
            "owner": "fbarrella",
            "repo": "reson8"
        },
        "beforePack": "scripts/before-pack.mjs",
        "files": [
            "dist/**/*",
            "assets/**/*",
            "node_modules/**/*",
            "!node_modules/.cache",
            "!node_modules/@reson8/client",
            "!node_modules/@reson8/client/**/*",
            "!node_modules/@reson8/server",
            "!node_modules/@reson8/server/**/*",
            "!node_modules/@reson8/native-audio",
            "!node_modules/@reson8/native-audio/**/*",
            "!node_modules/@reson8/shared-types",
            "!node_modules/@reson8/shared-types/**/*",
            {
                "from": ".release-vendor/native-audio",
                "to": "node_modules/@reson8/native-audio",
                "filter": ["**/*"]
            },
            {
                "from": ".release-vendor/shared-types",
                "to": "node_modules/@reson8/shared-types",
                "filter": ["**/*"]
            }
        ],
        "asarUnpack": [
            ".release-vendor/native-audio/prebuilds/**/*.node"
        ],
        "win": {
            "target": "nsis",
            "icon": "assets/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        },
        "linux": {
            "target": [
                "AppImage"
            ],
            "category": "Network;AudioVideo",
            "icon": "assets/icon.png",
            "desktop": {
                "StartupWMClass": "Reson8"
            }
        },
        "mac": {
            "target": "zip",
            "icon": "assets/icon.icns"
        }
    },
    "dependencies": {
        "electron-updater": "^6.8.9",
        "mediasoup-client": "^3.18.7",
        "metascraper": "^5.49.25",
        "metascraper-description": "^5.49.25",
        "metascraper-image": "^5.49.25",
        "metascraper-title": "^5.49.25",
        "metascraper-url": "^5.49.25",
        "metascraper-video": "^5.49.25",
        "socket.io-client": "^4.8.0"
    },
    "devDependencies": {
        "@reson8/native-audio": "*",
        "@reson8/shared-types": "*",
        "@types/node": "^22.13.0",
        "electron": "34.5.8",
        "electron-builder": "^25.1.8",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0"
    }
}