# Copy this file to .env.local (already gitignored — never commit the real
# one) and fill in real values. apps/client/scripts/build-signed.mjs loads it
# automatically for `npm run build:win` / `build:linux` / `build:mac`, and
# scripts/release-all.mjs (repo root) loads it too — no manual `export`
# needed once this file exists.

# Windows code signing (Authenticode) — a .pfx/.p12 FILE certificate only;
# a USB hardware token (common for EV certs) can't be used this way, see
# the "Code Signing (Windows)" section in the root README.md.
CSC_LINK=./certs/certificate.pfx
CSC_KEY_PASSWORD=
