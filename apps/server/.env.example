# Reson8 Server Environment Variables
# Copy this file to .env and adjust as needed.

DATABASE_URL=postgresql://reson8:reson8@localhost:5432/reson8
REDIS_URL=redis://localhost:6379
PORT=9800

# Server identity — used when auto-creating the server record on first boot
SERVER_NAME="Reson8 Server"
SERVER_ADDRESS="localhost:9800"

# Set to "true" to seed default channels and roles on startup
SEED_DEFAULT_TEMPLATE=true

# Server Admin Instance ID (Set this to your Electron client's instance ID to get admin permissions)
ADMIN_INSTANCE_ID=""

# Private Server Password (optional — if set, clients must provide this password to connect)
# SERVER_PRIVATE_PASSWORD="your-secret-password"

# mediasoup Announced IPs for WebRTC ICE candidates
# Public IP or domain: used by remote clients connecting over the internet
# Supports raw IPs (e.g. 203.0.113.50) or domain names / DDNS (e.g. voice.example.com)
MEDIASOUP_ANNOUNCED_IP="127.0.0.1"
# Private/LAN IP (optional): enables hairpin NAT — lets the host connect from inside their own network
# MEDIASOUP_PRIVATE_ANNOUNCED_IP="192.168.1.100"

# Cloudinary CDN (optional — if all three are set, uploads go to Cloudinary instead of local disk)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ── Identity (Reson8 2.6.0+) ────────────────────────────────────────────────
# Each install proves it owns its identity with a key; the first signed
# connection binds the key to that user. All three settings are optional.
#
# Refuse clients older than 2.6.0 entirely (they can't prove their identity).
# Turn this on once everyone has updated. Users who already connected with
# 2.6.0 are protected either way.
# REQUIRE_SIGNED_IDENTITY=true
#
# Protect the admin account: only the key with this fingerprint can use
# ADMIN_INSTANCE_ID (copy it from the admin's Settings → About → Identity).
# ADMIN_KEY_FINGERPRINT=SHA256:...
#
# Only accept proofs made for these host[:port] names (as users type them in
# the connect box), so another server can't relay this server's challenge.
# List EVERY name the server is reached by (e.g. LAN IP and domain).
# AUTH_ALLOWED_HOSTS=chat.example.com,192.168.0.10:9800
